rules_version = '2';

// MathCrown Firestore security rules.
//
// Data model split, driven by a real privacy issue found in the app:
// `users/{uid}` holds private PII (full name, email, parent link code) and
// must never be broadly readable. `public_profiles/{uid}` is a small,
// deliberately-safe mirror (first name + last-initial only, grade, xp,
// level, wins) written by the client alongside `users/{uid}` — this is
// the only collection the leaderboard, Crown Holder, and student search
// features read across accounts.
//
// `challenges`, `battles`, and `crown_holders` use a baseline
// "must be signed in" rule rather than fully field-validated rules. This
// project is a static client-only app with no Cloud Functions, so nothing
// server-side can verify "did this student really win a duel" — the same
// trust model already implied by users/{uid}.xp being client-writable.
// Tighten further (e.g. restrict a battle doc's writes to its two
// participants) once you can test changes against the live project.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A verified parent<->child link exists (see parent_links/{parentUid}
    // below) — declared up top since both topic_stats and
    // redemption_requests read this.
    function isLinkedParentOf(childUid) {
      return exists(/databases/$(database)/documents/parent_links/$(request.auth.uid)/children/$(childUid));
    }

    // Private account data: owner only, always.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Public, privacy-safe leaderboard/search mirror: first-name +
    // last-initial only (enforced by app code, not by these rules — a
    // rule can't verify string shape reliably, so review app-side writes
    // if this ever needs stronger enforcement).
    match /public_profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Online-status lobby: anyone signed in can see who's online: a
    // student can only ever write their own presence doc.
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Per-grade "Crown Holder" title. Self-reported win, consistent with
    // the rest of this app's client-trusted XP/coins model — the doc's
    // `uid` field must match the writer.
    match /crown_holders/{gradeNum} {
      allow read: if signedIn();
      allow write: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Real-time 1v1 challenge/battle system (pre-existing). Baseline:
    // must be signed in. Not yet hardened to "only the two participants
    // may read/write their own battle doc" — see file header note.
    match /challenges/{challengeId} {
      allow read, write: if signedIn();
    }
    match /battles/{battleId} {
      allow read, write: if signedIn();
    }

    // Classroom code -> teacher lookup, plus the current Class Session
    // (same question set, same grade band, everyone in the class answers
    // independently at their own pace — see class_scores below for
    // results). Any signed-in user can read; only the owning teacher can
    // create/update it (e.g. to start/end a session); never deleted.
    match /classrooms/{classCode} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherUid == request.auth.uid;
      allow update: if signedIn() && resource.data.teacherUid == request.auth.uid;
      allow delete: if false;
    }

    // Per-student results for the CURRENT class session only (overwritten
    // each time a new session starts) — a student can only write their
    // own doc; the teacher and classmates can read all of them to build
    // the session leaderboard.
    match /classrooms/{classCode}/scores/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Per-topic mastery ("where does this student need help") — the
    // most sensitive student data in this app, so it gets the strictest
    // rule here: readable ONLY by the student themselves or by the
    // teacher of record for the classCode on the doc (one extra lookup
    // to confirm that teacher actually owns that class) — never by
    // classmates, unlike public_profiles/leaderboard data. A student can
    // only write their own doc.
    match /topic_stats/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isLinkedParentOf(uid) ||
        (resource.data.classCode != null &&
         get(/databases/$(database)/documents/classrooms/$(resource.data.classCode)).data.teacherUid == request.auth.uid)
      );
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Real reward claims (Season Mastery Rewards, Weekly Champions).
    // Only the Cloudflare Worker creates these, using the service account
    // (which bypasses these rules), after checking the student's plan,
    // progress and a server-graded Mastery Check — so clients can't create
    // one at all. The student and their linked parent can read them; the
    // linked parent can move a pending claim to approved/denied (and
    // record themselves as approvedBy, so whoever fulfills it knows which
    // parent to deliver to). Marking a claim "fulfilled" happens out-of-band
    // in the Firebase Console, never through the app.
    //
    // Server-only collections with deliberately NO rule here (Firestore
    // denies all client access by default): entitlements, mastery_checks,
    // mastery_passes, mastery_attempts, reward_claims.
    match /redemption_requests/{reqId} {
      allow create: if false;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isLinkedParentOf(resource.data.uid));
      allow update: if signedIn() && isLinkedParentOf(resource.data.uid)
        && resource.data.status == "pending"
        && request.resource.data.status in ["approved", "denied"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "respondedAt", "approvedBy"])
        && (!("approvedBy" in request.resource.data) || request.resource.data.approvedBy == request.auth.uid);
      allow delete: if false;
    }

    // Parent <-> child linking. `link_codes/{code}` is a code -> uid
    // lookup a student creates for themselves at signup (mirrors the
    // classrooms/{classCode} pattern above) so a parent who only has the
    // 6-digit code can resolve it to a uid without ever needing read
    // access to the student's private users/{uid} doc. It's never
    // updated or deleted — a stale/reused code is a one-way lookup, not a
    // live grant.
    match /link_codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if false;
    }

    // A parent's own linked-children list — entirely parent-owned (the
    // parent writes it after resolving a link_codes entry themselves), so
    // no write path on the student's side is needed at all. This doc's
    // existence is also what isLinkedParentOf() above checks to grant a
    // parent cross-account read on their child's redemption requests.
    match /parent_links/{parentUid}/children/{childUid} {
      allow read, write: if signedIn() && request.auth.uid == parentUid;
    }

    // Tournament registration (real, replaces a fabricated "1,240
    // registered" counter that used to sit here). One doc per
    // student+tournament; a student can only create/delete their own.
    // Read is open to any signed-in user, same baseline as
    // crown_holders/classrooms above, since the only thing read from it
    // in bulk is a registrant COUNT, not anyone's individual data.
    match /tournament_registrations/{regId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
